# ──────────────────────────────────────────────────────────────
#  Plantilla de variables de entorno — MyBooks
#  Cópiala a .env.local y rellena los valores reales:  cp .env.example .env.local
#  Este archivo SÍ se versiona (no lleva secretos, solo nombres).
#  Lo PÚBLICO lleva prefijo NEXT_PUBLIC_ (lo ve el navegador);
#  el resto es SECRETO y vive solo en el servidor.
# ──────────────────────────────────────────────────────────────

# Supabase — públicas: el navegador solo puede ver estas dos (RLS las frena)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SECRETO, solo server-side (nunca al navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (LLM) — SECRETO, solo server-side
ANTHROPIC_API_KEY=
# Modelo por defecto: el más barato (Claude Haiku). Cámbialo si necesitas más potencia.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Books — SECRETO, solo server-side
GOOGLE_BOOKS_API_KEY=
